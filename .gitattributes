# Normalize line endings for text files.
* text=auto

# Unity YAML assets/scenes/prefabs should stay as text.
*.unity text
*.prefab text
*.asset text
*.mat text
*.anim text
*.controller text
*.meta text
*.asmdef text
*.asmref text

# Common binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.mov binary
